# Environment Variables Template for Azure Deployment
# Copy this file to .env and fill in your actual values
# DO NOT commit .env file to version control

# Database Configuration (Azure Database for MySQL)
DB_DRIVER=com.mysql.cj.jdbc.Driver
DB_HOST=jdbc:mysql://your-mysql-server.mysql.database.azure.com
DB_PORT=3306
DB_NAME=onlinebookstore
DB_USERNAME=your-db-username@your-mysql-server
DB_PASSWORD=your-db-password

# Azure Cache for Redis (Optional - for session management)
REDIS_HOST=your-redis-cache.redis.cache.windows.net
REDIS_PORT=6380
REDIS_PASSWORD=your-redis-access-key
REDIS_SSL=true

# Azure Key Vault (Optional - for secrets management)
AZURE_KEYVAULT_URI=https://your-keyvault.vault.azure.net/
AZURE_TENANT_ID=your-azure-tenant-id
AZURE_CLIENT_ID=your-managed-identity-client-id

# Application Configuration
APP_NAME=OnlineBookStore
APP_VERSION=1.0.0
APP_ENVIRONMENT=production

# Logging Configuration
LOG_LEVEL=INFO
